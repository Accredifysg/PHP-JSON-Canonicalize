{
    "name": "accredifysg/php-json-canonicalize",
    "description": "A PHP implementation of the IETF JSON Canonicalization Scheme (JCS, RFC 8785).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/accredifysg/php-json-canonicalize",
    "keywords": ["json", "canonicalization", "jcs", "rfc8785", "rfc-8785", "i-json", "es6", "ecmascript", "signatures", "deterministic"],
    "autoload": {
        "psr-4": {
            "Accredify\\JsonCanonicalize\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Accredify\\JsonCanonicalize\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-hash": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "pestphp/pest": "^2.14",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": [
            "@php vendor/bin/pint",
            "@php vendor/bin/phpstan analyse --no-progress"
        ],
        "lint:check": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --no-progress"
        ],
        "test": [
            "@php vendor/bin/pest --testsuite=Unit"
        ],
        "test:coverage": [
            "@php vendor/bin/pest --testsuite=Unit --coverage"
        ],
        "test:conformance": [
            "@php vendor/bin/pest --testsuite=Conformance"
        ],
        "test:all": [
            "@php vendor/bin/pest"
        ]
    }
}
